# MongoDB connection string. Leave empty to use a local persistent in-memory MongoDB for development.
# Production: use a dedicated least-privilege database user, for example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/madrasa_miftah?retryWrites=true&w=majority
MONGODB_URI=

# Use an ephemeral local MongoDB managed by mongodb-memory-server. Development only.
USE_IN_MEMORY_DB=true
IN_MEMORY_DB_PATH=.data/mongo
# Optional: existing mongod executable. On Windows 10 CPUs without AVX2, point this at MongoDB 7.0.x
# because MongoDB 8.x can crash on restart. Use an absolute path for reliability.
# MONGOMS_VERSION=7.0.37
# MONGOMS_SYSTEM_BINARY=C:/path/to/backend/.mongo/bin/mongod.exe

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-development-secret-before-running

# URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Session lifetime in days
SESSION_DAYS=7

# One-time seed bootstrap. If SEED_ADMIN_PASSWORD is blank, a strong random password is generated and printed once.
SEED_ADMIN_NAME=Madrasa Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO=true

# Public shipping defaults (can also be edited in admin settings)
DEFAULT_SHIPPING_FEE=250
DEFAULT_FREE_SHIPPING_ABOVE=5000

# Uploads (stored outside public static directories; public images are served via /uploads/public)
UPLOAD_STORAGE_PATH=uploads
MAX_UPLOAD_MB=5

# Optional email/SMS integrations are not enabled by default. Password reset links are shown
# in the API response only in development and are written to the audit log for administrators.

# Public WhatsApp number for order confirmations (international format, no +)
WHATSAPP_NUMBER=923343595001
